#!/usr/bin/python3
"""Click GNOME Maps' "Current Location" button via AT-SPI.

Run as the graphical session user (uid 10000), not root. The script fills in
the session bus and runtime directory if the SSH environment did not export
them, then finds the Maps window and activates its Current Location button.
"""
import os
import sys

uid = os.getuid()
if uid == 0:
    print("run as the session user (uid 10000), not root", file=sys.stderr)
    sys.exit(2)

os.environ.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % uid)
os.environ.setdefault(
    "DBUS_SESSION_BUS_ADDRESS", "unix:path=/run/user/%d/bus" % uid
)
os.environ.setdefault("HOME", "/home/user")

import gi

gi.require_version("Atspi", "2.0")
from gi.repository import Atspi


def walk(node, out):
    out.append(node)
    for i in range(node.get_child_count()):
        walk(node.get_child_at_index(i), out)


Atspi.init()
desktop = Atspi.get_desktop(0)
for i in range(desktop.get_child_count()):
    app = desktop.get_child_at_index(i)
    if app.get_name() != "org.gnome.Maps":
        continue

    nodes = []
    walk(app, nodes)
    for node in nodes:
        if node.get_role_name() != "button":
            continue
        if node.get_name() != "Current Location":
            continue

        action = node.get_action_iface()
        if action is None or action.get_n_actions() < 1:
            print("Current Location button has no click action", file=sys.stderr)
            sys.exit(1)
        action.do_action(0)
        print("clicked Current Location")
        sys.exit(0)

print("GNOME Maps is not running or has no Current Location button", file=sys.stderr)
sys.exit(1)
