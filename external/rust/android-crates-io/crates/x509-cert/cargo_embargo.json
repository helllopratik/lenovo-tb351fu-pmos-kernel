{
  "apex_available": [
    "//apex_available:platform",
    "com.android.virt"
  ],
  "features": [],
  "module_visibility": {
    "libx509_cert": [
      "//packages/modules/Virtualization:__subpackages__",
      "//system/keymint:__subpackages__",
      "//system/security/keystore2/tests:__subpackages__",
      "//system/security/keystore2/test_utils:__subpackages__"
    ],
    "libx509_cert_nostd": [
      "//packages/modules/Virtualization:__subpackages__",
      "//system/keymint:__subpackages__"
    ]
  },
  "run_cargo": false,
  "variants": [
    {},
    {
      "module_name_overrides": {
        "libconst_oid": "libconst_oid_nostd",
        "libder": "libder_nostd",
        "libflagset": "libflagset_nostd",
        "libspki": "libspki_nostd",
        "libx509_cert": "libx509_cert_nostd"
      },
      "package": {
        "x509-cert": {
          "force_rlib": true,
          "host_supported": false,
          "no_std": true
        }
      }
    },
    {
      "package": {
        "x509-cert": {
          "alloc": true,
          "no_std": true
        }
      },
      "generate_androidbp": false,
      "generate_rulesmk": true
    }
  ],
  "min_sdk_version": "29"
}