#!/bin/sh

COMPOSITOR="/usr/bin/phoc"
PHOC_INI="/usr/share/phosh/phoc.ini"
PHOSH_SESSION_BIN=${PHOSH_SESSION_BIN:-gnome-session}

help()
{
  cat <<EOF
phosh-session - Session start script for Phosh

This is usually invoked by a display manager but you can
also run it from a tty.

Usage: phosh
EOF
  exit 0
}


version()
{
   echo "0.55.0"
   exit 0
}

case "$1" in
  -h|-\?|--help)
    help
    ;;
  --version)
    version
    ;;
esac

if [ -x /usr/bin/phoc ]; then
  COMPOSITOR=/usr/bin/phoc
fi

if [ -f /etc/phosh/phoc.ini ]; then
  PHOC_INI=/etc/phosh/phoc.ini
fi

if [ -f "$HOME/.phoshdebug" ]; then
  echo "WARN: .phoshdebug found."
  . "$HOME/.phoshdebug"
fi

if which systemd-cat >/dev/null 2>&1; then
  SYSTEMD_CAT="systemd-cat -t phoc"
fi

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
  echo "INFO: No DBus user session found, spawning it."
  DBUS_RUN_SESSION="dbus-run-session --"
fi

# export WLR_RENDERER=pixman
export WLR_NO_HARDWARE_CURSORS=1
[ -n "$WLR_BACKENDS" ] || WLR_BACKENDS=drm,libinput
# export WLR_RENDERER=pixman
export WLR_NO_HARDWARE_CURSORS=1
export WLR_BACKENDS

# Render on the Mali-G57 via Panfrost when its render node exists.  KMS
# output stays on pmosfb (card0); WLR_RENDER_DRM_DEVICE gives wlroots a
# separate render node.  If Panfrost did not come up, leave the variable
# unset so phoc falls back to its pixman renderer instead of failing.
unset LIBGL_ALWAYS_SOFTWARE
if [ -e /dev/dri/renderD128 ]; then
  WLR_RENDER_DRM_DEVICE=/dev/dri/renderD128
  export WLR_RENDER_DRM_DEVICE
fi
# TB351FU: keep the builtin output enabled when phosh blanks, so phoc never
# disables the output and touch keeps working.  True panel darkness is
# provided by pmos-display-guard through the i2c-3 WLED registers.
if [ -f /usr/local/lib/phosh-nopoweroff.so ]; then
  LD_PRELOAD="/usr/local/lib/phosh-nopoweroff.so${LD_PRELOAD:+:$LD_PRELOAD}"
  export LD_PRELOAD
fi
exec $SYSTEMD_CAT $DBUS_RUN_SESSION "${COMPOSITOR}" -v -S -C "${PHOC_INI}" -E "${PHOSH_SESSION_BIN} --session=phosh"
