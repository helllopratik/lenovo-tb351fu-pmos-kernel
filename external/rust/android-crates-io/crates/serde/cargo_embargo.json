{
  "cfg_blocklist": [
    "std_atomic64"
  ],
  "min_sdk_version": "29",
  "run_cargo": false,
  "ramdisk_available": true,
  "recovery_available": true,
  "vendor_ramdisk_available": true,
  "package": {
    "serde": {
      "rulesmk_patch": "patches/rules.mk.diff",
      "add_module_block": "cargo_embargo_target_windows_enabled.bp.fragment"
    }
  },
  "variants": [
    {
      "features": [
        "default",
        "derive",
        "rc"
      ],
      "tests": true
    },
    {
      "features": [
        "alloc",
        "derive"
      ],
      "module_name_overrides": {
        "libserde": "libserde_nostd"
      },
      "package": {
        "serde": {
          "alloc": true,
          "force_rlib": true,
          "host_supported": false,
          "no_std": true
        }
      }
    },
    {
      "features": [
        "alloc",
        "default",
        "derive",
        "serde_derive",
        "std"
      ],
      "generate_rulesmk": true,
      "generate_androidbp": false
    }
  ],
  "native_bridge_supported": true
}
