{
  "apex_available": [
    "//apex_available:platform",
    "com.android.virt"
  ],
  "features": [
    "alloc",
    "derive",
    "flagset",
    "oid",
    "zeroize"
  ],
  "module_visibility": {
    "libder": [
      "//external/rust/android-crates-io/crates/sec1:__subpackages__",
      "//external/rust/android-crates-io/crates/spki:__subpackages__",
      "//external/rust/android-crates-io/crates/pkcs1:__subpackages__",
      "//external/rust/android-crates-io/crates/pkcs8:__subpackages__",
      "//external/rust/android-crates-io/crates/x509-cert:__subpackages__",
      "//packages/modules/Virtualization:__subpackages__",
      "//system/keymint:__subpackages__",
      "//system/security/keystore2:__subpackages__",
      "//system/software_defined_vehicle/core_services/service_discovery/sdv_sd_agent:__subpackages__"
    ],
    "libder_nostd": [
      "//external/rust/android-crates-io/crates/sec1:__subpackages__",
      "//external/rust/android-crates-io/crates/spki:__subpackages__",
      "//external/rust/android-crates-io/crates/pkcs1:__subpackages__",
      "//external/rust/android-crates-io/crates/pkcs8:__subpackages__",
      "//external/rust/android-crates-io/crates/x509-cert:__subpackages__",
      "//packages/modules/Virtualization:__subpackages__",
      "//system/keymint:__subpackages__"
    ]
  },
  "vendor_available": true,
  "run_cargo": false,
  "variants": [
    {},
    {
      "module_name_overrides": {
        "libconst_oid": "libconst_oid_nostd",
        "libder": "libder_nostd",
        "libflagset": "libflagset_nostd",
        "libzeroize": "libzeroize_nostd"
      },
      "package": {
        "der": {
          "alloc": true,
          "force_rlib": true,
          "host_supported": false,
          "no_std": true
        }
      }
    },
    {
      "generate_androidbp": false,
      "generate_rulesmk": true
    }
  ],
  "min_sdk_version": "apex_inherit"
}
