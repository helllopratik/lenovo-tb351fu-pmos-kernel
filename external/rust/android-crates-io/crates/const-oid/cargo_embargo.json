{
  "apex_available": [
    "//apex_available:platform",
    "com.android.virt"
  ],
  "features": [
    "db"
  ],
  "module_visibility": {
    "libconst_oid": [
      "//external/rust/android-crates-io/crates/der:__subpackages__",
      "//external/rust/android-crates-io/crates/x509-cert:__subpackages__",
      "//packages/modules/Virtualization:__subpackages__"
    ],
    "libconst_oid_nostd": [
      "//external/rust/android-crates-io/crates/der:__subpackages__",
      "//external/rust/android-crates-io/crates/x509-cert:__subpackages__",
      "//packages/modules/Virtualization:__subpackages__"
    ]
  },
  "run_cargo": false,
  "variants": [
    {},
    {
      "module_name_overrides": {
        "libconst_oid": "libconst_oid_nostd"
      },
      "package": {
        "const-oid": {
          "alloc": true,
          "force_rlib": true,
          "host_supported": false,
          "no_std": true
        }
      }
    },
    {
      "generate_androidbp": false,
      "generate_rulesmk": true
    }
  ],
  "min_sdk_version": "apex_inherit"
}
